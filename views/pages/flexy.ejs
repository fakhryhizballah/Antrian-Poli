<div class="min-h-screen bg-slate-100 text-slate-900 antialiased">
    <div class="flex min-h-screen flex-col">
        <header class="shrink-0 bg-slate-950 px-4 py-4 text-white shadow-lg sm:px-6">
            <div class="mx-auto flex w-full max-w-[1920px] flex-col items-center justify-center gap-1 text-center">
                <h1
                    class="cursor-pointer text-xl font-extrabold tracking-wide sm:text-2xl lg:text-3xl"
                    onclick="audiotest()"
                    title="Klik untuk menguji audio"
                >
                    ANTRIAN POLIKLINIK RSUD DR Abdul Aziz
                </h1>
                <p class="text-xs font-medium tracking-widest text-slate-300 sm:text-sm">
                    INFORMASI ANTRIAN PASIEN RAWAT JALAN
                </p>
            </div>
        </header>

        <main class="mx-auto w-full max-w-[1920px] flex-1 px-3 py-3 sm:px-4 sm:py-4">
            <section
                id="bath_antrian"
                class="grid grid-cols-1 items-stretch gap-3 xl:grid-cols-2 xl:gap-4"
                aria-label="Daftar antrean poliklinik"
            >
                <% for (let i = 1; i <= 2; i++) { %>
                    <section class="flex h-[calc(100vh-8.5rem)] min-h-[420px] min-w-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                        <header class="shrink-0 border-b border-slate-200 bg-white px-3 pb-3 pt-4 sm:px-4">
                            <div class="mb-3 text-center">
                                <p class="mb-1 text-[11px] font-bold uppercase tracking-[0.18em] text-blue-700">
                                    Daftar antrean
                                </p>
                                <h2 id="bath<%= i %>_poliklinik" class="min-h-7 break-words text-lg font-extrabold leading-tight text-slate-900 sm:text-xl">
                                    Memuat poliklinik...
                                </h2>
                                <p id="<%= i === 1 ? 'tanggal' : `tanggal${i}` %>" class="mt-1 text-xs font-medium text-slate-500 sm:text-sm">
                                    Memuat tanggal...
                                </p>
                            </div>

                            <div class="grid grid-cols-4 gap-1.5 sm:gap-2" aria-label="Ringkasan antrean">
                                <div class="min-w-0 rounded-xl border border-emerald-200 bg-emerald-50 px-1.5 py-2 text-center sm:px-2">
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-emerald-800 sm:text-xs">Sudah</p>
                                    <p id="bath<%= i %>_sudah" class="mt-0.5 text-xl font-extrabold tabular-nums text-emerald-900 sm:text-2xl">0</p>
                                </div>
                                <div class="min-w-0 rounded-xl border border-amber-200 bg-amber-50 px-1.5 py-2 text-center sm:px-2">
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-amber-800 sm:text-xs">Belum</p>
                                    <p id="bath<%= i %>_belum" class="mt-0.5 text-xl font-extrabold tabular-nums text-amber-900 sm:text-2xl">0</p>
                                </div>
                                <div class="min-w-0 rounded-xl border border-rose-200 bg-rose-50 px-1.5 py-2 text-center sm:px-2">
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-rose-800 sm:text-xs">Batal</p>
                                    <p id="bath<%= i %>_batal" class="mt-0.5 text-xl font-extrabold tabular-nums text-rose-900 sm:text-2xl">0</p>
                                </div>
                                <div class="min-w-0 rounded-xl border border-blue-200 bg-blue-50 px-1.5 py-2 text-center sm:px-2">
                                    <p class="text-[10px] font-bold uppercase tracking-wide text-blue-800 sm:text-xs">Total</p>
                                    <p id="bath<%= i %>_total" class="mt-0.5 text-xl font-extrabold tabular-nums text-blue-900 sm:text-2xl">0</p>
                                </div>
                            </div>

                            <div class="mt-3 flex items-center justify-between gap-2 text-[11px] text-slate-500">
                                <span class="font-semibold uppercase tracking-wide">Pasien</span>
                                <span class="inline-flex items-center gap-1.5">
                                    <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                                    Pembaruan langsung
                                </span>
                            </div>
                        </header>

                        <div
                            id="bath<%= i %>_antrian"
                            class="flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto overscroll-contain p-2.5 sm:p-3"
                            aria-live="polite"
                            aria-label="Daftar pasien"
                        >
                            <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-3 py-6 text-center text-sm text-slate-500">
                                Menunggu data antrean...
                            </div>
                        </div>
                    </section>
                <% } %>
            </section>
        </main>
    </div>
</div>

<script src="/asset/js/audio.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/asset/js/flexy.js"></script>
