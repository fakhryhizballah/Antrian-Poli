<div class="container mx-auto p-4 sm:p-6 max-w-7xl">
    <h1 class="text-2xl sm:text-4xl font-bold text-center mb-6 sm:mb-8">
        PANGGIL PASIEN - POLI: <span id="poli_name" class="text-blue-600"><%=kd_poli%></span>
    </h1>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
        
        <!-- Right Panel (Mobile Priority): Display Panggilan Saat Ini -->
        <!-- order-1 di mobile agar tampil di atas, lg:order-2 kembali ke kanan di desktop -->
        <div class="order-1 lg:order-2 lg:col-span-1">
            <div class="bg-gradient-to-br from-blue-500 to-blue-700 rounded-lg shadow-lg p-6 sm:p-8 text-white flex flex-col justify-between sticky top-4 sm:top-6">
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-center">PANGGILAN SAAT INI</h2>
                    <div class="bg-white bg-opacity-10 rounded-lg p-4 sm:p-6 text-center">
                        <p class="text-xs sm:text-sm opacity-80 mb-1 sm:mb-2">No. Urut</p>
                        <p id="display_no_reg" class="text-5xl sm:text-6xl font-bold mb-3 sm:mb-4">--</p>
                        <p class="text-xs sm:text-sm opacity-80 mb-1 sm:mb-2">Nama Pasien</p>
                        <p id="display_nm_pasien" class="text-lg sm:text-xl font-semibold mb-3 sm:mb-4 break-words">-</p>
                        <p class="text-xs sm:text-sm opacity-80 mb-1 sm:mb-2">Dokter</p>
                        <p id="display_nm_dokter" class="text-base sm:text-lg font-semibold">-</p>
                    </div>
                </div>
                <div class="text-xs opacity-75 text-center mt-4 lg:mt-6">
                    <p id="last_call_time">-</p>
                </div>
            </div>
        </div>

        <!-- Left Panel: Daftar Pasien -->
        <!-- order-2 di mobile, lg:order-1 di desktop -->
        <div class="order-2 lg:order-1 lg:col-span-2">
            <div class="bg-white rounded-lg shadow-lg p-4 sm:p-6">
                <h2 class="text-xl sm:text-2xl font-bold mb-4">Daftar Penunggu</h2>
                <!-- max-h-[60vh] di mobile agar pengguna tetap bisa scroll body keseluruhan -->
                <div id="pasien_list" class="space-y-3 max-h-[60vh] lg:max-h-96 overflow-y-auto pr-2 custom-scrollbar">
                    <p class="text-gray-500 text-center py-8">Loading data pasien...</p>
                </div>
            </div>
        </div>

    </div>
</div>


<script src="/socket.io/socket.io.js"></script>
<script src="/asset/js/panggil.js"></script>
